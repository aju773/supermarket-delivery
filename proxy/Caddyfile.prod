# Production: Caddy gets and renews the HTTPS certificate for SITE_DOMAIN by itself.
{$SITE_DOMAIN} {
	encode zstd gzip

	@api path /api /api/*
	handle @api {
		reverse_proxy api:8000
	}
	handle /media/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		reverse_proxy web:3000
	}
}
