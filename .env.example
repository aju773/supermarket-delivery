# Copy to .env for local development: cp .env.example .env
# Every service reads its configuration from these variables.

# Host port the reverse proxy listens on; the site is http://localhost:<PROXY_PORT>.
PROXY_PORT=8090

# PostgreSQL database, created by the db service on first start.
POSTGRES_DB=supermarket
POSTGRES_USER=supermarket
POSTGRES_PASSWORD=change-me
# Where Django finds the database ("db" is the Compose service).
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django. Use a long random secret outside local development.
DJANGO_SECRET_KEY=dev-only-not-secret
DJANGO_DEBUG=true
# Comma-separated host names Django answers to ("api" is the name the web container uses).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
# Comma-separated origins allowed to send CSRF-protected requests, e.g. https://shop.example.com.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8090

# Where the Next.js server calls the API from inside Compose (browsers use /api on the proxy).
API_INTERNAL_URL=http://api:8000

# Optional: site the Playwright tests open; defaults to http://localhost:<PROXY_PORT>.
# E2E_BASE_URL=http://localhost:8090

# Shop name shown in the customer top bar until the shop's own branding is known.
SHOP_NAME=Fresh Mart
