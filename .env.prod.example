# Production settings. On the server: cp .env.prod.example .env.prod, fill in every value, never commit it.
# Compose reads this file for every service (see compose.prod.yaml and docs/deployment.md).

# The shop's domain; Caddy gets the HTTPS certificate for it. DNS must already point at the server.
SITE_DOMAIN=shop.example.com

# Where the images are pulled from: ghcr.io/<github-owner>/<repo> in lower case.
IMAGE_PREFIX=ghcr.io/owner/supermarket
# "latest" or a commit SHA to pin or roll back.
IMAGE_TAG=latest

# PostgreSQL (created by the db service on first start). Use a long random password.
POSTGRES_DB=supermarket
POSTGRES_USER=supermarket
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django. Generate the secret with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=shop.example.com,api
DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com
DJANGO_MEDIA_ROOT=/app/media

API_INTERNAL_URL=http://api:8000

# The shop's display name.
SHOP_NAME=

# Backups. Comma-separated rclone destinations; one on Oracle, one somewhere else.
BACKUP_REMOTES=oracle:shop-backups,offsite:shop-backups
BACKUP_KEEP_DAYS=30
# Hour of the night (container time zone) the backup runs.
BACKUP_HOUR=02
TZ=Asia/Kolkata

# Oracle Object Storage through its S3-compatible API (Customer Secret Key, not the console login).
RCLONE_CONFIG_ORACLE_TYPE=s3
RCLONE_CONFIG_ORACLE_PROVIDER=Other
RCLONE_CONFIG_ORACLE_ACCESS_KEY_ID=
RCLONE_CONFIG_ORACLE_SECRET_ACCESS_KEY=
# https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
RCLONE_CONFIG_ORACLE_ENDPOINT=
RCLONE_CONFIG_ORACLE_REGION=
RCLONE_CONFIG_ORACLE_FORCE_PATH_STYLE=true

# The copy that lives off Oracle (example: Backblaze B2 through its S3 API; any S3 service works).
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Other
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
RCLONE_CONFIG_OFFSITE_ENDPOINT=
RCLONE_CONFIG_OFFSITE_REGION=
